# =================================================================
# EthioFarm / AgriEtech - Production Environment Blueprint
# =================================================================
# Instructions: Copy to .env or inject these variables in your
# container/PaaS environment (Render, AWS ECS, GCP Cloud Run, K8s).

# ── Core Runtime & Network ─────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_NAME=EthioFarm
APP_URL=https://agrietech.onrender.com
FRONTEND_URL=https://ethiofarm.et,https://ethiofarm-web.onrender.com

# Production CORS Whitelist: Explicit domains separated by commas (NO wildcard in production!)
CORS_ORIGIN=https://ethiofarm.et,https://www.ethiofarm.et,https://ethiofarm-web.onrender.com,https://agrietech.onrender.com

# ── Production Database (PostgreSQL 15+ / Supabase Pooler) ────────
# Note: For Supabase on cloud hosts, use the port 5432 or 6543 pooler endpoint
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&supavisor_session_mode=transaction"

# ── Cryptographically Secure JWT Keys ─────────────────────────────
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_64_CHAR_HEX_SECRET_FOR_PRODUCTION_ACCESS_TOKEN
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_CHAR_HEX_SECRET_FOR_REFRESH_TOKEN
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Enterprise Admin Security ──────────────────────────────────────
ADMIN_API_KEYS=GENERATE_SECURE_ADMIN_API_KEY_HERE
ADMIN_CONSOLE_PASSWORD=SetSecureEnterprisePasswordHere123!
ADMIN_EMAIL=admin@ethiofarm.et
BOOTSTRAP_ADMIN_ON_STARTUP=false

# ── Redis & Queue Services (Upstash / Redis Cloud / Self-Hosted) ──
REDIS_URL=rediss://default:[PASSWORD]@[HOST]:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true

# ── Supabase Cloud Storage ────────────────────────────────────────
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET_DIAGNOSE=diagnose
SUPABASE_BUCKET_AUDIO=audio
SUPABASE_BUCKET_PRIVATE=private

# ── SMS / USSD Telecommunication Gateway (SMS Ethiopia / Africa's Talking)
SMS_PROVIDER=smsethiopia
SMS_ETHIOPIA_API_KEY=YOUR_SMSETHIOPIA_KEY
SMS_ETHIOPIA_SENDER_ID=EthioFarm
USSD_SHORT_CODE=*212#

# ── AI & Agronomic Vision APIs ────────────────────────────────────
OPENROUTER_API_KEY=YOUR_OPENROUTER_PRODUCTION_KEY
OPENROUTER_MODEL=minimax/minimax-m3:free
PLANTNET_API_KEY=YOUR_PLANTNET_KEY
PERENUAL_API_KEY=YOUR_PERENUAL_KEY
PLANT_ID_API_KEY=YOUR_PLANT_ID_KEY

# ── Weather & Geospatial Earth Observation ─────────────────────────
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_KEY
GLOFAS_API_KEY=YOUR_COPERNICUS_KEY
EARTHDATA_BEARER_TOKEN=YOUR_NASA_TOKEN

# ── Production SMTP Email Delivery ────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_OR_MAILGUN_KEY
EMAIL_FROM=notifications@ethiofarm.et
