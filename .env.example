# =================================================================
# EthioFarm Multi-Hazard Platform - Environment Configuration Blueprint
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL 15 with PostGIS)
DATABASE_URL="postgresql://username:password@host:5432/database_name"

# Supabase Cloud Storage
SUPABASE_URL="https://your_project_ref.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"
SUPABASE_BUCKET_DIAGNOSES=diagnose
SUPABASE_BUCKET_AUDIO=audio
SUPABASE_BUCKET_PRIVATE=ethiofarm

# Redis & BullMQ Queue Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_if_required
REDIS_TLS=false

# JWT Authentication (GENERATE SECURE SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=GENERATE_SECURE_64_CHAR_HEX_STRING_HERE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# IoT Sensor API Keys (comma-separated)
SENSOR_API_KEYS=sensor_key_1,sensor_key_2,sensor_key_3
IOT_API_KEYS=iot_device_key_here

# Africa's Talking (SMS / USSD Gateway)
AFRICAS_TALKING_API_KEY=your_africastalking_api_key
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=EthioFarm

# External Weather / Climate / Earth Observation API Keys
OPENWEATHER_API_KEY=your_openweather_api_key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
GLOFAS_API_KEY=your_copernicus_glofas_key
EARTHDATA_BEARER_TOKEN=your_nasa_earthdata_token
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Plant.id / Kindwise Botanical API (Crop Health & Botanical Identification)
PLANT_ID_API_KEY=your_plant_id_or_kindwise_api_key
PLANT_ID_API_URL=https://plant.id/api/v3

# Google Gemini AI Studio Configuration (Multi-Key Pool: 6,000 requests/day free tier)
GEMINI_API_KEY=your_primary_gemini_api_key
GEMINI_API_KEY_2=your_second_gemini_api_key
GEMINI_API_KEY_3=your_third_gemini_api_key
GEMINI_API_KEY_4=your_fourth_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Firebase IoT Sensors & Realtime Database
FIREBASE_DATABASE_URL="https://your_project.firebaseio.com"
FIREBASE_API_KEY="your_firebase_api_key_here"
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Email / SMTP Configuration (Optional for development, used for Password Reset & Verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@ethiofarm.et
